POSTGRES_PASSWORD=flashopify
POSTGRES_PORT=5432

REDIS_PORT=6379

KAFKA_CLUSTER_ID=flashopify-local-cluster1
KAFKA_PORT=9092
KAFKA_UI_PORT=8081

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=flashopify-media
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
