# Copy to infra/docker/.env and adjust. Values here are local-only defaults, never real secrets.

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=flashopify
MYSQL_USER=flashopify
MYSQL_PASSWORD=flashopify
MYSQL_PORT=3306

PGVECTOR_DATABASE=flashopify_ai
PGVECTOR_USER=flashopify
PGVECTOR_PASSWORD=flashopify
PGVECTOR_PORT=5432

REDIS_PORT=6379

KAFKA_CLUSTER_ID=flashopify-local-cluster1
KAFKA_PORT=9092
KAFKA_UI_PORT=8081

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=flashopify-media
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Backend object storage (see backend application-local.yml); only needed to override defaults.
STORAGE_BUCKET=flashopify-media
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PATH_STYLE=true

# Seed job (scripts/seed/seed.sh): the admin account and the one password shared by the 1,000 customers.
# Placeholders only; pick your own local values in infra/docker/.env.
SEED_ADMIN_EMAIL=admin@flashopify.local
SEED_ADMIN_PASSWORD=change-me-local-only
SEED_ADMIN_NAME="Flashopify Admin"
SEED_CUSTOMER_PASSWORD=change-me-local-only

MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
