# Copy to infra/docker/.env and adjust. Values here are local-only defaults, never real secrets.

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=flashopify
MYSQL_USER=flashopify
MYSQL_PASSWORD=flashopify
MYSQL_PORT=3306

POSTGRES_DB=flashopify_ai
