<mxfile host="app.diagrams.net"><diagram id="context" name="1. Context"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="1. System Context – Flashopify" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="500" height="40" as="geometry"/></mxCell><mxCell id="cust" value="Customer&lt;br&gt;&lt;small&gt;mua hàng, flash-sale, hỏi AI&lt;/small&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=14;labelPerimeter=1;" vertex="1" parent="1"><mxGeometry x="245" y="60" width="30" height="60" as="geometry"/></mxCell><mxCell id="admin" value="Admin&lt;br&gt;&lt;small&gt;sản phẩm, chiến dịch, đơn&lt;/small&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=14;labelPerimeter=1;" vertex="1" parent="1"><mxGeometry x="565" y="60" width="30" height="60" as="geometry"/></mxCell><mxCell id="sys" value="&lt;b&gt;Flashopify&lt;/b&gt;&lt;br&gt;&lt;small&gt;E-commerce flash-sale: storefront + admin web, REST API, AI assistant&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="200" y="240" width="440" height="80" as="geometry"/></mxCell><mxCell id="pay" value="Payment Gateway&lt;br&gt;&lt;small&gt;giả lập (mock)&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="170" height="60" as="geometry"/></mxCell><mxCell id="llm" value="LLM Provider&lt;br&gt;&lt;small&gt;OpenAI / Gemini / Ollama&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="230" y="420" width="170" height="60" as="geometry"/></mxCell><mxCell id="dj" value="DummyJSON&lt;br&gt;&lt;small&gt;sản phẩm + ảnh (seed 1